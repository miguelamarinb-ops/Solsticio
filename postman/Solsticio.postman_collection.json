                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Autentica a un usuario del personal con email y contraseña y devuelve un token JWT (HS256, válido 1 hora). El token se envía en los demás endpoints protegidos con la cabecera Authorization: Bearer <token>.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@solsticio.com\",\n  \"password\": \"Admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.access_token) { pm.collectionVariables.set('token', d.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/auth/perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/perfil",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "perfil"
              ]
            },
            "description": "Devuelve los datos del usuario dueño del token: nombres, rol y sede asignada. Si el token falta, es inválido o expiró responde 401."
          }
        }
      ]
